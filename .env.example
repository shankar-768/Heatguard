# ==============================================================================
# HeatGuard AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as needed.

PORT=5000

# Weather API Provider: 'openmeteo', 'weatherapi', or 'openweathermap'
WEATHER_API_PROVIDER=openmeteo

# External API Keys (Paste your secret keys here):
WEATHER_API_KEY=your_weather_api_key_here
AIR_QUALITY_API_KEY=your_air_quality_api_key_here

# Base URLs
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
AIR_QUALITY_API_BASE_URL=https://air-quality-api.open-meteo.com/v1
